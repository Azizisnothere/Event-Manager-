      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.expect([200]).to.include(pm.response.code); });",
                  "pm.test('database ok', function () { pm.expect(pm.response.json().checks.database).to.eql('ok'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/health"
          }
        }
      ]
    },
