    {
      "name": "Login",
      "item": [
        {
          "name": "Login valid -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.expect([200]).to.include(pm.response.code); });",
                  "const j = pm.response.json();",
                  "pm.test('bearer token, 1 hour', function () { pm.expect(j.token_type).to.eql('Bearer'); pm.expect(j.expires_in).to.eql(3600); });",
                  "pm.test('JWT is HS256 with user_id and role only', function () { const parts = j.token.split('.'); const h = JSON.parse(atob(parts[0].replace(/-/g,'+').replace(/_/g,'/'))); const p = JSON.parse(atob(parts[1].replace(/-/g,'+').replace(/_/g,'/'))); pm.expect(h.alg).to.eql('HS256'); pm.expect(Object.keys(p).sort()).to.eql(['exp','iat','role','user_id']); });",
                  "pm.collectionVariables.set('org_a_token', j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/login",
