        {
          "name": "Me with tampered role in JWT -> 401",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.collectionVariables.get('org_a_token').split('.');",
                  "const p = JSON.parse(atob(t[1].replace(/-/g,'+').replace(/_/g,'/')));",
                  "p.role = 'staff';",
                  "const enc = btoa(JSON.stringify(p)).replace(/=+$/,'').replace(/\\+/g,'-').replace(/\\//g,'_');",
                  "pm.collectionVariables.set('tampered_token', t[0] + '.' + enc + '.' + t[2]);"
                ]
              }
            },
