            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = pm.collectionVariables.get('run_id') || (Date.now().toString(36) + Math.floor(Math.random() * 1e4));",
                  "pm.collectionVariables.set('run_id', run);",
                  "pm.collectionVariables.set('org_a_email', 'org_a-' + run + '@example.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', function () { pm.expect([201]).to.include(pm.response.code); });",
                  "const j = pm.response.json();",
                  "pm.test('role is always organizer', function () { pm.expect(j.user.role).to.eql('organizer'); });",
                  "pm.test('password_hash never returned', function () { pm.expect(JSON.stringify(j)).to.not.include('password_hash'); });",
                  "pm.collectionVariables.set('org_a_token', j.token);",
