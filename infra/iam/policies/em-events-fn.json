{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "Logs", "Effect": "Allow", "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"], "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/em-events-fn:*" },
    { "Sid": "ReadSecrets", "Effect": "Allow", "Action": ["secretsmanager:GetSecretValue"],
      "Resource": ["arn:aws:secretsmanager:us-east-1:000000000000:secret:em/db-url*", "arn:aws:secretsmanager:us-east-1:000000000000:secret:em/jwt-secret*", "arn:aws:secretsmanager:us-east-1:000000000000:secret:em/geoapify-api-key*"] },
    { "Sid": "PublishDomainEvents", "Effect": "Allow", "Action": ["sns:Publish"],
      "Resource": "arn:aws:sns:us-east-1:000000000000:em-domain-events" },
    { "Sid": "QueueEmails", "Effect": "Allow", "Action": ["sqs:SendMessage"],
      "Resource": "arn:aws:sqs:us-east-1:000000000000:em-notifications" },
    { "Sid": "SignCsvUploadLinks", "Effect": "Allow", "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::em-guest-imports/imports/*" },
    { "Sid": "RateLimits", "Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/em-request-guard" }
  ]
}
