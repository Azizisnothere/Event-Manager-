# Copy to .env and fill in. NEVER commit .env. No real values in this file.

# ---- PC: dev-server.js ---------------------------------------------------------
PORT=3000
FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:8080
# Links inside emails point here
FRONTEND_BASE_URL=http://localhost:8080
NODE_ENV=development
LOG_LEVEL=info
# Emails are written to dev/outbox/ unless this is true (then Brevo sends them)
DEV_SEND_REAL_EMAIL=false
DEV_OUTBOX_API=true
DEV_SCHEDULER_SECONDS=60

# ---- Database ------------------------------------------------------------------
# Neon: app connection (restricted user em_app) and owner connection (migrations only)
DATABASE_URL=postgresql://em_app:PASSWORD@HOST/neondb?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://neondb_owner:PASSWORD@HOST/neondb?sslmode=verify-full
# Sets the em_app password when you run npm run migrate
EM_APP_DB_PASSWORD=
# "disable" ONLY for a local Docker Postgres (never Neon, never production)
DB_SSL=
DB_POOL_MAX=2

# ---- Secrets (PC values; on Lambda only the *_SECRET_NAME variables are set) ---
# At least 32 random characters
JWT_SECRET=
# Cloudflare test secret 1x0000000000000000000000000000000AA always passes
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
BREVO_API_KEY=
GEOAPIFY_API_KEY=
# Lambda: Secrets Manager names (leave empty on the PC)
DB_URL_SECRET_NAME=
JWT_SECRET_NAME=
TURNSTILE_SECRET_NAME=
BREVO_API_KEY_SECRET_NAME=
GEOAPIFY_API_KEY_SECRET_NAME=
SECRETS_CACHE_TTL_SECONDS=3600

# ---- Email sender (not secret) ---------------------------------------------------
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Event Manager
DISPLAY_TIME_ZONE=Africa/Cairo

# ---- AWS / Floci (empty = everything in memory on the PC) ------------------------
AWS_REGION=us-east-1
# Floci: http://localhost:4566
AWS_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT=
IMPORTS_BUCKET=
REPORTS_BUCKET=
REQUEST_GUARD_TABLE=
DOMAIN_EVENTS_TOPIC_ARN=
NOTIFICATIONS_QUEUE_URL=

# ---- Optional ----------------------------------------------------------------------
TURNSTILE_EXPECTED_HOSTNAME=
# Point the external APIs at local stubs (ignored when NODE_ENV=production)
TURNSTILE_VERIFY_URL=
GEOAPIFY_API_URL=

# ---- Deploy to Floci (npm run deploy) ----------------------------------------------
# Public HTTPS tunnel addresses for the demo (see infra/README.md); empty = localhost only
PUBLIC_API_URL=
PUBLIC_WEB_URL=
# Real Turnstile site key for the public website (public by design); empty = Cloudflare test key
TURNSTILE_SITE_KEY=
LAMBDA_RUNTIME=nodejs22.x
